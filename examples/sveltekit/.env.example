# Copy to .env and fill in.

# Mollie test API key: Dashboard → Developers → API keys (starts with test_).
MOLLIE_API_KEY=test_...

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:5173

# Mollie cannot reach localhost. Expose the dev server with a tunnel
# (e.g. `ngrok http 5173`) and put its webhook URL here. Without it, the
# success redirect and the sync still keep subscriptions up to date.
MOLLIE_WEBHOOK_URL=

# Protects POST /api/cron/sync (call it hourly from your scheduler).
CRON_SECRET=change-me

# SQLite file (Node's built-in node:sqlite).
DATABASE_PATH=sqlite.db
